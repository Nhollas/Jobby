# Address to listen on. Defaults to :8080.
ADDR=:8080

DATABASE_URL=postgres://jobby:jobby@localhost:5432/jobby?sslmode=disable

# From the Clerk dashboard: API Keys > Show JWT public key > PEM.
# Newlines may be written as literal \n on one line.
CLERK_ISSUER=https://your-app.clerk.accounts.dev
CLERK_PEM_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"

# Optional, comma-separated. Origins allowed to have requested a token (its
# azp claim). Leave empty to accept any.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
